#!/usr/bin/env bash
set -euo pipefail

echo "  → shellcheck..."
shellcheck -s bash privacity lib/*.sh 2>&1 | grep -E "SC[0-9]* \((error|warning)\)" && {
  echo "  ✗ shellcheck: warnings found, aborting commit"
  exit 1
} || echo "  ✓ shellcheck clean"

echo "  → bats tests..."
if command -v bats &>/dev/null; then
  if bats tests/*.bats >/dev/null 2>&1; then
    echo "  ✓ all tests passed"
  else
    echo "  ✗ tests failed, aborting commit"
    exit 1
  fi
else
  echo "  - bats not installed, skipping tests"
fi
