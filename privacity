#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# privacity — VPN Gate auto-connector with guided CLI and daemon mode
#
# Author:  Martin
# License: GPL v3 (see LICENSE file)
#
# I built this to quickly find and connect to the fastest public VPN Gate
# servers without having to dig through their web interface.  It picks the
# server with the highest score, downloads its OpenVPN config, and handles
# the whole connection lifecycle.
#
#   Commands:
#     privacity             Interactive guided mode (default)
#     privacity daemon      Connect in background – no terminal needed
#     privacity daemon --persist   Install systemd user service
#     privacity daemon --unpersist Remove systemd user service
#     privacity disconnect  Tear down the current VPN
#     privacity reconnect   Pick a new server and reconnect
#     privacity status      Show connection details and live speed
#     privacity speedtest   Measure download & upload speed via Cloudflare
#     privacity update      Pull latest version from git and reinstall
#     privacity help        This message
#
#   Options:
#     -c, --country <name>   Filter servers by country
#     --fast                 Sort servers by lowest ping instead of highest score
#     --log-file <path>      Write output to log file
#     --profile <name>       Use isolated profile (config + data)
#     --verbose              Show timestamps and detailed output
#
# Install:
#   sudo make install
#   sudo make completions
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_URL="https://github.com/marelizal/privacity.git"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/lib/common.sh" ]]; then
  LIB_DIR="$SCRIPT_DIR/lib"
else
  LIB_DIR="/usr/local/lib/privacity"
fi
# shellcheck disable=SC1090
for _privacity_lib in common net speed csv ovpn; do
  source "$LIB_DIR/$_privacity_lib.sh"
done
unset _privacity_lib

# ──────── Update ─────────────────────────────────────────────────────────────

cmd_update() {
  command -v git &>/dev/null || die "git is required to update. Install: sudo apt install git"

  local tmpdir
  tmpdir=$(mktemp -d) || die "Failed to create temp directory."
  trap 'rm -rf "${tmpdir:-}"' RETURN

  _do_clone() { git clone --depth=1 -q "$REPO_URL" "$tmpdir" >/dev/null 2>&1; }
  run_with_spinner \
    "Downloading latest version..." \
    _do_clone \
    || die "Failed to clone repository. Check your connection."
  unset -f _do_clone 2>/dev/null || true

  cd "$tmpdir"

  _do_install() { _sudo make install && _sudo make completions; }
  run_with_spinner "Installing..." _do_install >/dev/null 2>&1 \
    || warn "Install failed. Run ${BOLD}sudo privacity update${NC} manually."
  unset -f _do_install 2>/dev/null || true

  local new_version
  new_version=$(cd "$tmpdir" && bash -c 'source lib/common.sh 2>/dev/null; echo "$VERSION"' 2>/dev/null || echo "?")
  [[ "$new_version" != "?" ]] && log "Updated to version ${new_version}"
}

