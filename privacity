    ${GREEN}--fast${NC}            Sort servers by lowest ping (ms)
    ${GREEN}--protocol <type>${NC}  Force protocol: ovpn, wg, auto (default)
    ${GREEN}--log-file <path>${NC}  Write output to log file
    ${GREEN}--verbose${NC}          Show timestamps and detailed output

  ${BOLD}COMMANDS${NC}
    ${GREEN}privacity${NC}          Daemon mode — connect in background (default)
    ${GREEN}privacity --countries${NC}  Show all available countries
