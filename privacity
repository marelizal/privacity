# ──────── Speedtest command ──────────────────────────────────────────────────

cmd_speedtest() {
  printf "\n"
  local dl ul
  dl=$(measure_speed)
  log "Download speed: ${BOLD}${dl} Mbps${NC}"
  ul=$(measure_upload_speed)
  log "Upload speed:   ${BOLD}${ul} Mbps${NC}"
  printf "\n"
}

# ──────── Countries command ─────────────────────────────────────────────────

cmd_countries() {
  if ! _cache_fresh "$CSV"; then
    fetch_servers
  fi

  local countries
  countries=$(list_countries "$CSV" 2>/dev/null) || die "No server list available."

  printf "\n  ${BOLD}${WHITE}Available countries${NC}\n\n"
  echo "$countries" | while IFS= read -r line; do
    printf "  ${GREEN}●${NC} %s\n" "$line"
  done
  printf "\n"
  info "Use ${BOLD}privacity -c <name>${NC} to filter by country"
  info "Use ${BOLD}privacity -c <name> list${NC} to list servers in a country"
  printf "\n"
}

_no_servers_hint() {
  local country="$1"
  error "No servers found${country:+ for '$country'}"
  if [[ -n "$country" ]] && _cache_fresh "$CSV" 2>/dev/null; then
    local countries
    countries=$(list_countries "$CSV" 2>/dev/null)
    local match
    match=$(echo "$countries" | grep -i "$country" || true)
    if [[ -n "$match" ]]; then
      info "Did you mean: ${BOLD}$match${NC}?"
    else
      warn "Available countries:"
      echo "$countries" | sed 's/^/  /'
    fi
  fi
  exit 1
}

# ──────── List command ──────────────────────────────────────────────────────

cmd_list() {
  local country="${1:-}"
  local fast="${2:-false}"

  if ! _cache_fresh "$CSV"; then
    fetch_servers
  else
    log "Using cached server list..."
  fi

  mapfile -t servers < <(parse_servers "$CSV" "$country" "$fast")
  ((${#servers[@]})) || die "No servers found${country:+ for $country}."

  printf "\n  ${BOLD}${WHITE}Servers${NC}"
  [[ -n "$country" ]] && printf " ${DIM}($country)${NC}"
  printf "\n\n"
  printf "  ${DIM}%-4s %-20s  %-30s  %8s  %6s${NC}\n" "  #" "Country" "Hostname" "Score" "Ping"
  printf "  ${DIM}%s${NC}\n" "  -----------------------------------------------------------"

  local count=${#servers[@]}
  local max_show=20
  (( count > max_show )) && count=$max_show

  for ((i=0; i<count; i++)); do
    local h c s p ping_disp
    h=$(echo "${servers[$i]}" | cut -d'|' -f1)
    c=$(echo "${servers[$i]}" | cut -d'|' -f2)
    s=$(echo "${servers[$i]}" | cut -d'|' -f4)
    p=$(echo "${servers[$i]}" | cut -d'|' -f5)
    if [[ "$p" -le 30 ]]; then
      ping_disp="${GREEN}${p}ms${NC}"
    elif [[ "$p" -le 80 ]]; then
      ping_disp="${YELLOW}${p}ms${NC}"
    else
      ping_disp="${RED}${p}ms${NC}"
    fi
    printf "  %2d)  %-20s  %-30s  ${YELLOW}%'8d${NC}  %b\n" $((i+1)) "$c" "$h" "$s" "$ping_disp"
  done

  if [[ -z "$country" ]]; then
    printf "\n"
    log "Available countries:"
    local countries
    countries=$(list_countries "$CSV" 2>/dev/null)
    echo "$countries" | tr '\n' ' ' | fold -s -w 70 | sed 's/^/  /'
  fi

  printf "\n"
  info "Enter server number to connect (0 to exit): "
  read -r sel
  if [[ -n "$sel" && "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#servers[@]} )); then
    connect_interactive "${servers[$((sel-1))]}"
  fi
}

# ──────── Main dispatch ─────────────────────────────────────────────────────

main() {
  trap 'printf "\n"; exit 1' INT TERM

  check_deps
  load_config

  local country="${CONFIG_COUNTRY:-}"
  local fast="${CONFIG_FAST:-false}"
  local default_mode="${CONFIG_MODE:-}"
  # shellcheck disable=SC2034
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--country) country="$2"; shift 2 ;;
      --fast) fast=true; shift ;;
      --log-file) LOG_FILE="$2"; shift 2 ;;
      --profile) use_profile "$2"; shift 2 ;;
      --verbose) VERBOSE=true; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  if [[ -n "$LOG_FILE" ]]; then
    mkdir -p "$(dirname "$LOG_FILE")"
    exec > >(tee -a "$LOG_FILE") 2>&1
    printf "\n[%s] === privacity session started ===\n" "$(date '+%Y-%m-%d %H:%M:%S')"
  fi

  local cmd="${1:-${default_mode}}"

  case "$cmd" in
    daemon|d)
      case "${2:-}" in
        --persist)
          shift 2
          cmd_persist
          exit 0
          ;;
        --unpersist)
          shift 2
          cmd_unpersist
          exit 0
          ;;
      esac
      if ! _cache_fresh "$CSV"; then
        fetch_servers
      else
        log "Using cached server list..."
      fi
      mapfile -t servers < <(parse_servers "$CSV" "$country" "$fast")
      if ((${#servers[@]})); then
        if [[ "$fast" == "true" ]]; then
          log "Sorting servers by lowest ping..."
        else
          log "Analysing servers by score..."
        fi
        connect_daemon "${servers[0]}"
      else
        _no_servers_hint "$country"
      fi
      ;;

    countries|paises)
      cmd_countries
      ;;

    disconnect|down|kill)
      cmd_disconnect
      ;;

    reconnect|re)
      cmd_reconnect "daemon" "$country" "$fast"
      ;;

    status|st)
      cmd_status
      ;;

    list|ls)
      cmd_list "$country" "$fast"
      ;;

    update|up)
      cmd_update
      ;;

    speedtest|speed)
      cmd_speedtest
      ;;

    help|--help|-h)
      cmd_help
      ;;

    *)
      while true; do
        header

        if ! _cache_fresh "$CSV"; then
          fetch_servers
        else
          log "Using cached server list..."
        fi

        mapfile -t servers < <(parse_servers "$CSV" "$country" "$fast")
        if ! ((${#servers[@]})); then
          _no_servers_hint "$country"
        fi
        local sort_msg
        if [[ "$fast" == "true" ]]; then
          sort_msg="Sorting servers by lowest ping..."
        else
          sort_msg="Analysing servers by score..."
        fi
        log "$sort_msg"

        local selected
        if ! selected=$(select_server "${servers[@]}"); then
          local rc=$?
          if [[ $rc -eq 1 ]]; then
            info "Cancelled."
            exit 0
          fi
          continue
        fi

        connect_interactive "$selected" && break
      done
      ;;
  esac
}
return 0 2>/dev/null || main "$@"
