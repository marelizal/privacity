  printf "  ${BOLD}USAGE${NC}\n"
  printf "    privacity ${DIM}[options] [command]${NC}\n"
  printf "\n"
  printf "  ${BOLD}OPTIONS${NC}\n"
  printf "    ${GREEN}-c, --country${NC}     Filter servers by country (name or code)\n"
  printf "    ${GREEN}--fast${NC}            Sort servers by lowest ping (ms)\n"
  printf "    ${GREEN}--log-file <path>${NC}  Write output to log file\n"
  printf "    ${GREEN}--profile <name>${NC}   Use isolated profile (config + data)\n"
  printf "    ${GREEN}--verbose${NC}          Show timestamps and detailed output\n"
  printf "\n"
  printf "  ${BOLD}COMMANDS${NC}\n"
  printf "    ${GREEN}privacity${NC}          Interactive guided mode (default)\n"
  printf "    ${GREEN}privacity countries${NC}   Show all available countries\n"
  printf "    ${GREEN}privacity daemon${NC}     Connect in background – no terminal needed\n"
  printf "    ${GREEN}privacity daemon --persist${NC}  Install systemd user service\n"
  printf "    ${GREEN}privacity daemon --unpersist${NC}  Remove systemd user service\n"
  printf "    ${GREEN}privacity list${NC}    Show top servers and available countries\n"
  printf "    ${GREEN}privacity disconnect${NC}  Tear down the current VPN\n"
  printf "    ${GREEN}privacity reconnect${NC}   Pick a new server and reconnect\n"
  printf "    ${GREEN}privacity status${NC}      Show connection details and live speed\n"
  printf "    ${GREEN}privacity speedtest${NC}   Measure download & upload speed\n"
  printf "    ${GREEN}privacity update${NC}      Pull latest version and reinstall\n"
  printf "    ${GREEN}privacity help${NC}        Show this message\n"
  printf "\n"
  printf "  ${BOLD}EXAMPLES${NC}\n"
  printf "    privacity                           Interactive mode\n"
  printf "  ${DIM}privacity countries${NC}                 Show available countries\n"
