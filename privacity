# ──────── Speedtest command ──────────────────────────────────────────────────

cmd_speedtest() {
  printf "\n"
  local dl ul
  dl=$(measure_speed)
  log "Download speed: ${BOLD}${dl} Mbps${NC}"
  ul=$(measure_upload_speed)
  log "Upload speed:   ${BOLD}${ul} Mbps${NC}"
  printf "\n"
}

# ──────── Countries command ─────────────────────────────────────────────────

cmd_countries() {
  if ! _cache_fresh "$CSV"; then
    fetch_servers
  fi

  local countries
  countries=$(list_countries "$CSV" 2>/dev/null) || die "No server list available."

  printf "\n  %sAvailable countries%s\n\n" "${BOLD}${WHITE}" "${NC}"
  echo "$countries" | while IFS= read -r line; do
    printf "  %s●%s %s\n" "${GREEN}" "${NC}" "$line"
  done
  printf "\n"
  info "Use ${BOLD}privacity -c <name>${NC} to filter by country"
  info "Use ${BOLD}privacity -c <name> list${NC} to list servers in a country"
  printf "\n"
}

_no_servers_hint() {
  local country="$1"
  # shellcheck disable=SC2016
  error "No servers found${country:+ for '$country'}"
  if [[ -n "$country" ]] && _cache_fresh "$CSV" 2>/dev/null; then
    local countries
    countries=$(list_countries "$CSV" 2>/dev/null)
    local match
    match=$(echo "$countries" | grep -i "$country" || true)
    if [[ -n "$match" ]]; then
      info "Did you mean: ${BOLD}$match${NC}?"
    else
      warn "Available countries:"
      # shellcheck disable=SC2001
      echo "$countries" | sed 's/^/  /'
    fi
  fi
  exit 1
}

# ──────── List command ──────────────────────────────────────────────────────

cmd_list() {
  local country="${1:-}"
  local fast="${2:-false}"

  if ! _cache_fresh "$CSV"; then
    fetch_servers
  else
    log "Using cached server list..."
  fi

  mapfile -t servers < <(parse_servers "$CSV" "$country" "$fast")
  ((${#servers[@]})) || die "No servers found${country:+ for $country}."

  printf "\n  %sServers%s" "${BOLD}${WHITE}" "${NC}"
  [[ -n "$country" ]] && printf " %s(%s)%s" "${DIM}" "$country" "${NC}"
  printf "\n\n"
  printf "  %s%-4s %-20s  %-30s  %8s  %6s%s\n" "${DIM}" "  #" "Country" "Hostname" "Score" "Ping" "${NC}"
  printf "  %s%s%s\n" "${DIM}" "  -----------------------------------------------------------" "${NC}"

  local count=${#servers[@]}
  local max_show=20
  (( count > max_show )) && count=$max_show

  for ((i=0; i<count; i++)); do
    local h c s p ping_disp
    h=$(echo "${servers[$i]}" | cut -d'|' -f1)
    c=$(echo "${servers[$i]}" | cut -d'|' -f2)
    s=$(echo "${servers[$i]}" | cut -d'|' -f4)
    p=$(echo "${servers[$i]}" | cut -d'|' -f5)
    if [[ "$p" -le 30 ]]; then
      ping_disp="${GREEN}${p}ms${NC}"
    elif [[ "$p" -le 80 ]]; then
      ping_disp="${YELLOW}${p}ms${NC}"
    else
      ping_disp="${RED}${p}ms${NC}"
    fi
    printf "  %2d)  %-20s  %-30s  %s%'8d%s  %b\n" $((i+1)) "$c" "$h" "${YELLOW}" "$s" "${NC}" "$ping_disp"
  done

  if [[ -z "$country" ]]; then
    printf "\n"
    info "Available countries:"
    list_countries "$CSV" 2>/dev/null | tr '\n' ' ' | fold -s -w 70 | sed 's/^/  /'
    printf "\n"
  fi

}

# ──────── Main dispatch ─────────────────────────────────────────────────────

main() {
  trap 'printf "\n"; exit 1' INT TERM

  check_deps
  load_config

  local country="${CONFIG_COUNTRY:-}"
  local fast="${CONFIG_FAST:-false}"
  local protocol="${CONFIG_PROTOCOL:-auto}"
  local server=""
  local default_mode="${CONFIG_MODE:-}"
  # shellcheck disable=SC2034
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--country) country="$2"; shift 2 ;;
      --fast) fast=true; shift ;;
      --server) server="$2"; shift 2 ;;
      --protocol) protocol="$2"; shift 2 ;;
      --log-file) LOG_FILE="$2"; shift 2 ;;
      --verbose) VERBOSE=true; shift ;;
      --countries) cmd_countries; exit 0 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  if [[ -n "$LOG_FILE" ]]; then
    mkdir -p "$(dirname "$LOG_FILE")"
    exec > >(tee -a "$LOG_FILE") 2>&1
    printf "\n[%s] === privacity session started ===\n" "$(date '+%Y-%m-%d %H:%M:%S')"
  fi

  local cmd="${1:-${default_mode:-daemon}}"

  case "$cmd" in
    daemon|d)
      case "${2:-}" in
        --persist)
          shift 2
          cmd_persist
          exit 0
          ;;
        --unpersist)
          shift 2
          cmd_unpersist
          exit 0
          ;;
      esac
      connect_best "$country" "$fast" "$protocol" "$server"
      ;;

    countries|paises)
      cmd_countries
      ;;

    disconnect|down|kill)
      cmd_disconnect
      ;;

    reconnect|re)
      cmd_reconnect "$country" "$fast" "$protocol" "$server"
      ;;

    status|st)
      cmd_status
      ;;

    list|ls)
      cmd_list "$country" "$fast"
      ;;

    update|up)
      cmd_update
      ;;

    speedtest|speed)
      cmd_speedtest
      ;;

    help|--help|-h)
      cmd_help
      ;;

    *)
      connect_best "$country" "$fast" "$protocol" "$server"
      ;;
  esac
}

connect_best() {
  local country="${1:-}"
  local fast="${2:-false}"
  local protocol="${3:-auto}"
  local server="${4:-}"

  if [[ "$fast" == "true" ]]; then
    log "Sorting servers by lowest ping...${country:+ ($country)}"
  else
    log "Analysing servers by score...${country:+ ($country)}"
  fi

  local entry
  entry=$(pick_entry "$country" "$fast" "$protocol" "$server")
  connect_tunnel "$entry"
}
# shellcheck disable=SC2317
return 0 2>/dev/null || main "$@"
