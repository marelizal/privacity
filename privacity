#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# privacity — VPN Gate auto-connector with guided CLI and daemon mode
#
# Author:  Martin
# License: GPL v3 (see LICENSE file)
#
# I built this to quickly find and connect to the fastest public VPN Gate
# servers without having to dig through their web interface.  It picks the
# server with the highest score, downloads its OpenVPN config, and handles
# the whole connection lifecycle.
#
#   Commands:
#     privacity           Interactive guided mode (default)
#     privacity daemon    Connect in background – no terminal needed
#     privacity disconnect  Tear down the current VPN
#     privacity reconnect   Pick a new server and reconnect
#     privacity status    Show connection details and live speed
#     privacity speedtest Measure download speed via Cloudflare
#     privacity update    Pull latest version from git and reinstall
#     privacity help      This message
#
# Install:
#   sudo make install
#   sudo make completions
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_URL="https://github.com/marelizal/privacity.git"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/lib/common.sh" ]]; then
  LIB_DIR="$SCRIPT_DIR/lib"
else
  LIB_DIR="/usr/local/lib/privacity"
fi
for _privacity_lib in common net speed csv ovpn; do
  source "$LIB_DIR/$_privacity_lib.sh"
done
unset _privacity_lib

# ──────── Update ─────────────────────────────────────────────────────────────

cmd_update() {
  command -v git &>/dev/null || die "git is required to update. Install: sudo apt install git"

  local tmpdir
  tmpdir=$(mktemp -d) || die "Failed to create temp directory."
  trap 'rm -rf "${tmpdir:-}"' RETURN

  log "Downloading latest version..."
  if ! git clone --depth=1 "$REPO_URL" "$tmpdir" 2>&1; then
    die "Failed to clone repository. Check your connection."
  fi

  cd "$tmpdir"

  log "Installing..."
  sudo make install >/dev/null 2>&1
  sudo make completions >/dev/null 2>&1 || true

  local new_version
  new_version=$(sed -n '/^readonly VERSION=/ { s/^readonly VERSION="//; s/"$//; p }' privacity 2>/dev/null || echo "?")
  log "Updated to version ${new_version}"
}

# ──────── Help ──────────────────────────────────────────────────────────────

cmd_help() {
  printf "\n  ${BOLD}${WHITE}Privacity${NC} ${DIM}v${VERSION}${NC} ${WHITE}—${NC} ${DIM}VPN Gate Client${NC}\n"
  printf "  ${BOLD}USAGE${NC}\n"
  printf "    privacity ${DIM}[command]${NC}\n"
  printf "\n"
  printf "  ${BOLD}COMMANDS${NC}\n"
  printf "    ${GREEN}privacity${NC}        Interactive guided mode (default)\n"
  printf "    ${GREEN}privacity daemon${NC}  Connect in background – no terminal needed\n"
  printf "    ${GREEN}privacity disconnect${NC}  Tear down the current VPN\n"
  printf "    ${GREEN}privacity reconnect${NC}   Pick a new server and reconnect\n"
  printf "    ${GREEN}privacity status${NC}      Show connection details and live speed\n"
  printf "    ${GREEN}privacity speedtest${NC}   Measure download speed via Cloudflare\n"
  printf "    ${GREEN}privacity update${NC}      Pull latest version and reinstall\n"
  printf "    ${GREEN}privacity help${NC}        Show this message\n"
  printf "\n"
  printf "  ${BOLD}INSTALL${NC}\n"
  printf "    sudo make install\n"
  printf "    sudo make completions\n"
  printf "\n"
}

# ──────── Speedtest command ──────────────────────────────────────────────────

cmd_speedtest() {
  printf "\n"
  local speed_mbps
  speed_mbps=$(measure_speed)
  log "Download speed: ${BOLD}${speed_mbps} Mbps${NC}"
  printf "\n"
}

# ──────── Main dispatch ─────────────────────────────────────────────────────

main() {
  trap 'printf "\n"; exit 1' INT TERM

  check_deps

  local cmd="${1:-}"
  shift 2>/dev/null || true

  case "$cmd" in
    daemon|d)
      if ! _cache_fresh "$CSV"; then
        fetch_servers
      else
        log "Using cached server list..."
      fi
      mapfile -t servers < <(parse_servers "$CSV")
      ((${#servers[@]})) || die "No servers found."
      log "Analysing servers by score..."
      connect_daemon "${servers[0]}"
      ;;

    disconnect|down|kill)
      cmd_disconnect
      ;;

    reconnect|re)
      cmd_reconnect "daemon"
      ;;

    status|st)
      cmd_status
      ;;

    update|up)
      cmd_update
      ;;

    speedtest|speed)
      cmd_speedtest
      ;;

    help|--help|-h)
      cmd_help
      ;;

    *)
      while true; do
        header

        if ! _cache_fresh "$CSV"; then
          fetch_servers
        else
          log "Using cached server list..."
        fi

        mapfile -t servers < <(parse_servers "$CSV")
        ((${#servers[@]})) || die "No valid servers found."
        log "Analysing servers by score..."

        show_top "${servers[@]}"

        local best="${servers[0]}"
        local h c
        h=$(echo "$best" | cut -d'|' -f1)
        c=$(echo "$best" | cut -d'|' -f2)
        local s
        s=$(echo "$best" | cut -d'|' -f4)

        log "Best option found: ${BOLD}$h${NC} (${c}) — score: $(printf "%'d" "$s")"

        printf "\n  ${YELLOW}${BOLD}[?]${NC} Connect? ${DIM}[Y/n]${NC} "
        read -r yn
        if [[ "${yn,,}" == "n" ]]; then
          info "Cancelled."
          exit 0
        fi

        connect_interactive "$best" && break
      done
      ;;
  esac
}

return 0 2>/dev/null || main "$@"
