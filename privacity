#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# privacity — Conector automático para VPN Gate con CLI guiado y modo daemon
#
# Autor:  Martín
# Licencia: MIT (ver archivo LICENSE)
#
# Creé esta herramienta para encontrar y conectarme rápidamente a los
# servidores públicos de VPN Gate con mejor puntuación, sin tener que
# revisar su interfaz web manualmente.  El script elige el servidor con
# el Score más alto, descarga su configuración OpenVPN y gestiona todo
# el ciclo de vida de la conexión.
#
#   Comandos:
#     privacity             Modo interactivo guiado (por defecto)
#     privacity daemon      Conectar en background — sin terminal
#     privacity disconnect  Cerrar la VPN actual
#     privacity reconnect   Elegir un nuevo servidor y reconectar
#     privacity status      Mostrar detalles de la conexión y velocidad
#     privacity help        Este mensaje
#
# Instalación:
#   sudo make install
#   sudo make completions
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# ──────── Rutas y valores por defecto ───────────────────────────────────────
# Guardo todo bajo XDG_DATA_HOME para seguir el estándar Freedesktop.
DIR="${XDG_DATA_HOME:-$HOME/.local/share}/privacity"
CSV="$DIR/servers.csv"
OVPN_CONFIG="$DIR/active.ovpn"
PID_FILE="$DIR/privacity.pid"
LAST_HOST="$DIR/last_host"

# ──────── Colores (solo cuando stdout es una terminal) ──────────────────────
# Uso tput en lugar de escapes ANSI duros para que funcione en cualquier
# terminal que soporte terminfo.
if [[ -t 1 ]]; then
  BOLD=$(tput bold)
  DIM=$(tput dim)
  RED=$(tput setaf 1)
  GREEN=$(tput setaf 2)
  YELLOW=$(tput setaf 3)
  BLUE=$(tput setaf 4)
  CYAN=$(tput setaf 6)
  WHITE=$(tput setaf 7)
  NC=$(tput sgr0)
else
  BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""
  BLUE=""; CYAN=""; WHITE=""; NC=""
fi

# ──────── Funciones de log ──────────────────────────────────────────────────
# Antepongo un símbolo claro a cada línea para que el usuario pueda
# identificar de un vistazo el tipo de mensaje.
log()    { printf "${BOLD}${GREEN}[*]${NC} %s\n" "$*"; }
warn()   { printf "${BOLD}${YELLOW}[!]${NC} %s\n" "$*"; }
error()  { printf "${BOLD}${RED}[x]${NC} %s\n" "$*" >&2; }
info()   { printf "  ${CYAN}%s${NC}\n" "$*"; }
dim()    { printf "${DIM}%s${NC}\n" "$*"; }
die()    { error "$1"; exit 1; }

header() {
  clear
  printf "\n${BLUE}  :: ${BOLD}${WHITE}privacity${NC}${BLUE} :: VPN Gate Client${NC}\n"
  printf "${DIM}  ──────────────────────────────────────${NC}\n\n"
}

# ──────── Descarga y parseo de servidores ───────────────────────────────────
# VPN Gate expone un CSV en /api/iphone/.  Las primeras dos líneas son
# metadatos; cada línea siguiente es un servidor.  Tomo los primeros 50
# y los ordeno por Score descendente — a mayor Score, mejor servidor.

fetch_servers() {
  mkdir -p "$DIR"
  info "Descargando lista de servidores desde VPN Gate..."
  if ! wget -q -O "$CSV" --timeout=15 "http://www.vpngate.net/api/iphone/"; then
    die "No se pudo descargar la lista. Verifica tu conexión."
  fi
  log "Lista de servidores descargada"
}

parse_servers() {
  tail -n +3 "$CSV" | head -n 50 | tr -d '\r' |
  awk -F, '
    $2 != "" && $7 != "" && $15 != "" {
      score = $3 + 0
      printf "%s|%s|%s|%s|%s\n", $1, $6, $7, score, $15
    }' |
  sort -t'|' -k4 -rn
}

# ──────── Utilidades de red ─────────────────────────────────────────────────
# Necesito algunas comprobaciones ligeras para mostrar calidad de conexión:
# una consulta de IP externa y un ping rápido.

get_external_ip() {
  curl -s --max-time 5 https://ifconfig.me 2>/dev/null || echo "-"
}

get_ping() {
  ping -c 1 -W 3 "${1:-8.8.8.8}" 2>/dev/null |
    sed -n 's/.*time=\([0-9.]*\) ms/\1/p' || echo "-"
}

# ──────── Mostrar mejores servidores ────────────────────────────────────────
# Muestro los tres mejores candidatos para que el usuario sepa qué va
# a usar.  El primero lleva un marcador [*] llamativo.

show_top() {
  local servers=("$@")
  printf "\n"
  for ((i=0; i<3 && i<${#servers[@]}; i++)); do
    local hostname country_long score
    hostname=$(echo "${servers[$i]}" | cut -d'|' -f1)
    country_long=$(echo "${servers[$i]}" | cut -d'|' -f2)
    score=$(echo "${servers[$i]}" | cut -d'|' -f4)

    local marker
    ((i==0)) && marker="${GREEN}${BOLD}[*]${NC} " || marker="   "

    printf "  ${marker}%-20s  %-30s  ${YELLOW}%'10d${NC}\n" \
      "$country_long" "$hostname" "$score"
  done
  printf "\n"
}

# ──────── Generación de configuración OpenVPN ───────────────────────────────
# Decodifico la configuración Base64 que entrega VPN Gate, la escribo a
# un archivo local e inyecto la línea data-ciphers que OpenVPN ≥ 2.7
# necesita para evitar errores de negociación de cifrado.

write_config() {
  local base64_data="$1"
  echo "$base64_data" | base64 -d > "$OVPN_CONFIG"
  if ! grep -q "data-ciphers" "$OVPN_CONFIG"; then
    echo "" >> "$OVPN_CONFIG"
    echo "data-ciphers DEFAULT:AES-128-CBC" >> "$OVPN_CONFIG"
  fi
}

# ──────── Helpers para modo daemon ──────────────────────────────────────────
# Guardo el PID del proceso OpenVPN en background para que los comandos
# disconnect / status / reconnect puedan encontrarlo sin tener que
# recorrer la tabla de procesos.

save_pid() {
  echo "$1" > "$PID_FILE"
}

read_pid() {
  if [[ -f "$PID_FILE" ]]; then
    cat "$PID_FILE"
  fi
}

save_host() {
  echo "$1|$2" > "$LAST_HOST"
}

read_host() {
  if [[ -f "$LAST_HOST" ]]; then
    cat "$LAST_HOST"
  fi
}

# ──────── Conexión interactiva ─────────────────────────────────────────────
# Flujo guiado principal: buscar el mejor servidor, mostrarlo, pedir
# confirmación, conectar y entrar en un bucle de monitoreo en vivo que
# muestra velocidad de descarga/subida hasta que el usuario presiona Q.

connect_interactive() {
  local entry="$1"
  local hostname country_long score base64_data
  hostname=$(echo "$entry" | cut -d'|' -f1)
  country_long=$(echo "$entry" | cut -d'|' -f2)
  score=$(echo "$entry" | cut -d'|' -f4)
  base64_data=$(echo "$entry" | cut -d'|' -f5)

  write_config "$base64_data"
  save_host "$hostname" "$country_long"

  clear
  printf "\n${BLUE}  :: privacity :: connecting${NC}\n"
  dim "  ──────────────────────────────────────"
  printf "  ${BOLD}%-14s${NC} %s\n" "Host"    "$hostname"
  printf "  ${BOLD}%-14s${NC} %s\n" "Country" "$country_long"
  printf "  ${BOLD}%-14s${NC} %s\n" "Score"   "$(printf "%'d" "$score")"
  dim "  ──────────────────────────────────────\n"

  log "Iniciando OpenVPN..."

  sudo openvpn --config "$OVPN_CONFIG" --verb 3 &
  local ovpn_pid=$!

  # Espero hasta veinte segundos a que aparezca la interfaz tun0, que es
  # la señal que da OpenVPN cuando el túnel está establecido.
  local connected=false
  for attempt in $(seq 1 20); do
    if ip link show tun0 &>/dev/null 2>&1; then
      connected=true
      break
    fi
    if ! kill -0 "$ovpn_pid" 2>/dev/null; then
      break
    fi
    sleep 1
  done

  if ! $connected; then
    error "La conexión falló o se agotó el tiempo de espera."
    sudo kill "$ovpn_pid" 2>/dev/null || true
    wait "$ovpn_pid" 2>/dev/null || true
    return 1
  fi

  printf "\n"
  log "Conectado!"
  dim "  ──────────────────────────────────────"

  local ext_ip ping_ms rx1 rx2 tx1 tx2
  ext_ip=$(get_external_ip)
  ping_ms=$(get_ping)

  # Leo los contadores de bytes iniciales para poder calcular los deltas
  # de velocidad más adelante.
  rx1=$(cat /sys/class/net/tun0/statistics/rx_bytes 2>/dev/null || echo 0)
  tx1=$(cat /sys/class/net/tun0/statistics/tx_bytes 2>/dev/null || echo 0)

  printf "  ${BOLD}%-14s${NC} %s\n" "External IP" "$ext_ip"
  printf "  ${BOLD}%-14s${NC} %s ms\n" "Ping" "$ping_ms"
  printf "  ${BOLD}%-14s${NC} %s\n" "Location" "$country_long"
  dim "  ──────────────────────────────────────\n"

  printf "  ${YELLOW}${BOLD}[*]${NC} VPN activa. Presiona ${BOLD}${RED}Q${NC} para desconectar\n\n"

  # Bucle de velocidad en vivo — muestreo los contadores de bytes cada dos
  # segundos y calculo la tasa de transferencia.
  while true; do
    rx2=$(cat /sys/class/net/tun0/statistics/rx_bytes 2>/dev/null || echo 0)
    tx2=$(cat /sys/class/net/tun0/statistics/tx_bytes 2>/dev/null || echo 0)
    local rx_speed=$(( (rx2 - rx1) / 1024 ))
    local tx_speed=$(( (tx2 - tx1) / 1024 ))
    rx1=$rx2
    tx1=$tx2

    printf "\r  ${DIM}↓ ${rx_speed} KB/s  |  ↑ ${tx_speed} KB/s${NC}    "

    read -r -t 2 -n1 key || true
    if [[ -n "${key:-}" && "${key,,}" == "q" ]]; then
      printf "\n\n"
      log "Desconectando..."
      sudo kill "$ovpn_pid" 2>/dev/null || true
      wait "$ovpn_pid" 2>/dev/null || true
      log "Desconectado"
      break
    fi

    if ! kill -0 "$ovpn_pid" 2>/dev/null; then
      printf "\n\n"
      warn "La conexión VPN se perdió."
      break
    fi
  done
}

# ──────── Modo daemon (background) ──────────────────────────────────────────
# El subcomando daemon está pensado para quien no quiere mantener una
# terminal abierta.  Lanzo OpenVPN en background con --daemon, guardo el
# PID y salgo.

connect_daemon() {
  local entry="$1"
  local hostname country_long score base64_data
  hostname=$(echo "$entry" | cut -d'|' -f1)
  country_long=$(echo "$entry" | cut -d'|' -f2)
  score=$(echo "$entry" | cut -d'|' -f4)
  base64_data=$(echo "$entry" | cut -d'|' -f5)

  write_config "$base64_data"
  save_host "$hostname" "$country_long"

  log "Iniciando OpenVPN en modo daemon..."
  sudo openvpn --config "$OVPN_CONFIG" \
    --daemon \
    --log "$DIR/openvpn.log" \
    --writepid "$PID_FILE"

  # Le doy al daemon unos segundos para negociar el túnel.
  sleep 3

  if ip link show tun0 &>/dev/null 2>&1; then
    log "Conectado a ${hostname} (${country_long})"
    printf "\n"
    dim "  Ejecuta ${BOLD}privacity status${NC}${DIM} para ver la conexión${NC}"
    dim "  Ejecuta ${BOLD}privacity disconnect${NC}${DIM} para cerrarla${NC}"
  else
    warn "El daemon se inició pero no se detectó el túnel — revisa $DIR/openvpn.log"
  fi
}

# ──────── Desconexión ───────────────────────────────────────────────────────
# Mato el PID guardado y limpio el túnel.  Si no hay archivo PID, busco
# procesos openvpn por la ruta de configuración como fallback.

cmd_disconnect() {
  local pid
  pid=$(read_pid)

  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    log "Desconectando (PID $pid)..."
    sudo kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  else
    # Fallback: matar cualquier openvpn que esté usando nuestro archivo
    # de configuración.
    log "No se encontró el PID guardado — buscando procesos activos..."
    local pids
    pids=$(pgrep -f "openvpn.*$OVPN_CONFIG" 2>/dev/null || true)
    if [[ -n "$pids" ]]; then
      sudo kill $pids 2>/dev/null || true
    else
      warn "No se encontró una conexión VPN activa."
      return 1
    fi
  fi

  rm -f "$PID_FILE" "$LAST_HOST"
  log "Desconectado"
}

# ──────── Estado ────────────────────────────────────────────────────────────
# Muestro todo lo que el usuario necesita saber: si el túnel está activo,
# la IP externa, el ping, las tasas de transferencia y qué servidor se
# está usando.

cmd_status() {
  local hostname country_long
  if [[ -f "$LAST_HOST" ]]; then
    IFS='|' read -r hostname country_long < "$LAST_HOST"
  fi

  printf "\n${BLUE}  :: privacity :: status${NC}\n"
  dim "  ──────────────────────────────────────"

  if ip link show tun0 &>/dev/null 2>&1; then
    printf "  ${BOLD}%-14s${NC} ${GREEN}Conectado${NC}\n" "Estado"
    printf "  ${BOLD}%-14s${NC} %s\n" "Servidor" "${hostname:---}"
    printf "  ${BOLD}%-14s${NC} %s\n" "País" "${country_long:---}"

    local ext_ip ping_ms
    ext_ip=$(get_external_ip)
    ping_ms=$(get_ping)
    printf "  ${BOLD}%-14s${NC} %s\n" "IP externa" "$ext_ip"
    printf "  ${BOLD}%-14s${NC} %s ms\n" "Ping" "$ping_ms"

    # Una medición única de velocidad (muestra de dos segundos).
    local rx1 rx2 tx1 tx2
    rx1=$(cat /sys/class/net/tun0/statistics/rx_bytes 2>/dev/null || echo 0)
    tx1=$(cat /sys/class/net/tun0/statistics/tx_bytes 2>/dev/null || echo 0)
    sleep 2
    rx2=$(cat /sys/class/net/tun0/statistics/rx_bytes 2>/dev/null || echo 0)
    tx2=$(cat /sys/class/net/tun0/statistics/tx_bytes 2>/dev/null || echo 0)
    local rx_speed=$(( (rx2 - rx1) / 2048 ))
    local tx_speed=$(( (tx2 - tx1) / 2048 ))

    printf "  ${BOLD}%-14s${NC} ↓ %d KB/s  ↑ %d KB/s\n" "Velocidad" "$rx_speed" "$tx_speed"
  else
    printf "  ${BOLD}%-14s${NC} ${RED}Desconectado${NC}\n" "Estado"
  fi

  dim "  ──────────────────────────────────────\n"
}

# ──────── Reconexión ────────────────────────────────────────────────────────
# Cierro la conexión actual, elijo el mejor servidor de una lista nueva y
# vuelvo a conectar — ya sea en modo interactivo o daemon.

cmd_reconnect() {
  local mode="${1:-daemon}"
  cmd_disconnect 2>/dev/null || true
  sleep 1
  fetch_servers
  mapfile -t servers < <(parse_servers)
  ((${#servers[@]})) || die "No hay servidores disponibles."

  local best="${servers[0]}"
  local h c
  h=$(echo "$best" | cut -d'|' -f1)
  c=$(echo "$best" | cut -d'|' -f2)
  local s
  s=$(echo "$best" | cut -d'|' -f4)

  log "Reconectando a ${h} (${c}) — score: $(printf "%'d" "$s")"

  if [[ "$mode" == "daemon" ]]; then
    connect_daemon "$best"
  else
    connect_interactive "$best"
  fi
}

# ──────── Ayuda ─────────────────────────────────────────────────────────────
cmd_help() {
  printf "\n${BLUE}  :: ${BOLD}${WHITE}privacity${NC}${BLUE} :: VPN Gate Client${NC}\n"
  dim "  ──────────────────────────────────────"
  printf "\n"
  printf "  ${BOLD}USO${NC}\n"
  printf "    privacity ${DIM}[comando]${NC}\n"
  printf "\n"
  printf "  ${BOLD}COMANDOS${NC}\n"
  printf "    ${GREEN}privacity${NC}        Modo interactivo guiado (por defecto)\n"
  printf "    ${GREEN}privacity daemon${NC}  Conectar en background — sin terminal\n"
  printf "    ${GREEN}privacity disconnect${NC}  Cerrar la conexión VPN\n"
  printf "    ${GREEN}privacity reconnect${NC}   Elegir nuevo servidor y reconectar\n"
  printf "    ${GREEN}privacity status${NC}      Mostrar estado y velocidad en vivo\n"
  printf "    ${GREEN}privacity help${NC}        Mostrar este mensaje\n"
  printf "\n"
  printf "  ${BOLD}INSTALACIÓN${NC}\n"
  printf "    sudo make install\n"
  printf "    sudo make completions\n"
  printf "\n"
}

# ──────── Despacho principal ────────────────────────────────────────────────
# Analizo el primer argumento como subcomando y derivo a la función que
# corresponda.  Si no hay subcomando, ejecuto el flujo interactivo.

main() {
  trap 'printf "\n"; exit 1' INT TERM

  command -v openvpn &>/dev/null || die "OpenVPN no encontrado. Instala: sudo apt install openvpn"

  local cmd="${1:-}"
  shift 2>/dev/null || true

  case "$cmd" in
    daemon|d)
      # Conexión en background — útil para cron / scripts.
      if [[ ! -f "$CSV" ]] || (( $(date +%s) - $(stat -c %Y "$CSV" 2>/dev/null || echo 0) > 300 )); then
        fetch_servers
      fi
      mapfile -t servers < <(parse_servers)
      ((${#servers[@]})) || die "No se encontraron servidores."
      connect_daemon "${servers[0]}"
      ;;

    disconnect|down|kill)
      cmd_disconnect
      ;;

    reconnect|re)
      cmd_reconnect "daemon"
      ;;

    status|st)
      cmd_status
      ;;

    help|--help|-h)
      cmd_help
      ;;

    *)
      # Por defecto: modo interactivo guiado.
      header

      if [[ ! -f "$CSV" ]] || (( $(date +%s) - $(stat -c %Y "$CSV" 2>/dev/null || echo 0) > 300 )); then
        fetch_servers
      fi

      info "Analizando servidores por puntuación..."

      mapfile -t servers < <(parse_servers)
      ((${#servers[@]})) || die "No se encontraron servidores válidos."

      show_top "${servers[@]}"

      local best="${servers[0]}"
      local h c
      h=$(echo "$best" | cut -d'|' -f1)
      c=$(echo "$best" | cut -d'|' -f2)
      local s
      s=$(echo "$best" | cut -d'|' -f4)

      log "Mejor: ${BOLD}$h${NC} (${c}) — score: $(printf "%'d" "$s")"

      printf "\n  ${YELLOW}${BOLD}[?]${NC} ¿Conectar? ${DIM}[Y/n]${NC} "
      read -r yn
      if [[ "${yn,,}" == "n" ]]; then
        info "Cancelado."
        exit 0
      fi

      connect_interactive "$best"
      ;;
  esac
}

main "$@"
